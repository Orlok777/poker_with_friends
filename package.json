{
  "name": "blackjack-with-friends",
  "version": "1.0.0",
  "private": true,
  "description": "Multiplayer blackjack for a group of friends, played for fake chips",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "npm run build && node dist/server/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "screenshots": "npm run build && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
